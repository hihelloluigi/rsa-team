# ==============================================================================
# RSA TEAM — environment
# Copy to .env.local for local development. The public site builds and runs with
# none of these set; only /admin requires configuration.
# ==============================================================================

# ------------------------------------------------------------------------------
# Public site
# ------------------------------------------------------------------------------

# Canonical origin for metadataBase, canonical URLs, sitemap, JSON-LD and the
# calendar feed. Resolution order (src/lib/site.ts):
#   NEXT_PUBLIC_SITE_URL -> VERCEL_PROJECT_PRODUCTION_URL -> http://localhost:3002
# Optional, but worth pinning in production: the feed URL is copied permanently
# into subscribers' calendars, and the Vercel fallback follows domain settings.
# Leave unset locally so the site resolves to localhost.
# NEXT_PUBLIC_SITE_URL=https://www.rsateam.it

# Extra origins allowed to reach the dev server, for testing on a phone or
# through a tunnel. Development only; never set in Vercel.
# ALLOWED_DEV_ORIGINS=192.168.1.10:3002,my-tunnel.ngrok-free.app

# ------------------------------------------------------------------------------
# Admin (/admin) — all four are required for sign-in to work
# Set locally AND in Vercel (Production only: preview URLs change per deploy, so
# the OAuth callback would never match).
# ------------------------------------------------------------------------------

# Signs and encrypts the session cookie. Generate one per environment:
#   openssl rand -base64 32
# Do NOT run `npx auth secret` — that npm name belongs to a different library.
AUTH_SECRET=

# From the GitHub OAuth App (github.com/settings/developers).
# Callback URLs to register: https://www.rsateam.it/api/auth/callback/github
#                            http://localhost:3002/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# The only GitHub account allowed to sign in. This fails CLOSED: if it is unset
# or misspelt, nobody can sign in — including you.
ADMIN_GITHUB_LOGIN=hihelloluigi

# Where the admin commits. Both have defaults; set them only if the repo moves.
# ADMIN_GITHUB_REPO=hihelloluigi/rsa-team
# ADMIN_GITHUB_BRANCH=main
