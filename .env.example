# Canonical origin for metadataBase, canonical URLs, sitemap and JSON-LD.
# Resolution order (src/lib/site.ts):
#   NEXT_PUBLIC_SITE_URL -> VERCEL_PROJECT_PRODUCTION_URL -> http://localhost:3002
# Leave unset on Vercel; the platform supplies the second one.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Extra origins allowed to reach the dev server (phone / tunnel testing).
# ALLOWED_DEV_ORIGINS is dev-only.
# ALLOWED_DEV_ORIGINS=192.168.1.10:3002,my-tunnel.ngrok-free.app
